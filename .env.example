# Configuração do projeto. Copie para .env e ajuste se precisar:  cp .env.example .env
# O docker-compose.yaml tem os mesmos valores como padrão, então o projeto sobe mesmo sem o .env.
# Uma variável definida no terminal tem prioridade (ex.: AIRFLOW_WEB_PORT=8090 docker compose up -d).

# --- Versões das imagens -----------------------------------------------------
AIRFLOW_IMAGE=apache/airflow
AIRFLOW_VERSION=2.10.5-python3.11
POSTGRES_VERSION=16

# --- Portas expostas no host (mude se já estiverem em uso) -------------------
AIRFLOW_WEB_PORT=8085
DW_PORT=5454

# --- Airflow ------------------------------------------------------------------
# No Linux, use o seu UID para evitar problemas de permissão em ./logs (id -u)
AIRFLOW_UID=50000
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin
# Chave que criptografa senhas das Connections. Para gerar uma nova:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Trocar a chave depois que o banco foi criado deixa as connections ilegíveis
# (recrie com: docker compose down -v && docker compose up -d).
AIRFLOW_FERNET_KEY=07RuqMx-FLTKKII8Ob16t9Q6MlrsTdetHnD5LYIXe_k=
AIRFLOW_SECRET_KEY=wA9kY3Zu-IdXY-iNrCHAJogkWtA_KejpMLMGb3796GI

# --- Banco de metadados do Airflow -------------------------------------------
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow
AIRFLOW_DB_NAME=airflow

# --- Base analítica (shopbrasil_dw) ------------------------------------------
DW_USER=dw
DW_PASSWORD=senha_analitica_local
DW_DB=shopbrasil_dw

# --- Pipeline -----------------------------------------------------------------
FAKESTORE_API_URL=https://fakestoreapi.com
# Opcional: webhook (Slack/Teams/etc.) para receber os alertas simulados
ALERT_WEBHOOK_URL=
